# Example nginx strangler config — DigitalAuto
# Next.js = Pre-Inspection + shared platform
# Laravel = FI + Valuation + anything not yet cut over
#
# Migrated Next prefixes (keep in sync with docs/DECOMMISSION_CHECKLIST.md):
#   /login /logout /forgot-password /reset-password
#   /dashboard /tools /masters /account /logs
#   /jobs/assign|fresh|schedule|pending|inspect|qc|complete|reports
#   /api/auth/ /api/v2/ /api/health /_next/
#
# Adjust upstream hosts/ports for your environment.
# Copy to sites-available and enable after `nginx -t`.
# Runbook: docs/PHASE8_RUNBOOK.md

upstream next_upstream {
    server 127.0.0.1:3001;
    keepalive 32;
}

upstream laravel_upstream {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name digitalauto.example.com;

    client_max_body_size 64m;

    # --- Migrated: Next.js ---

    # Auth.js
    location ^~ /api/auth/ {
        proxy_pass http://next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PI + shared APIs (jobs, masters, account, pdf, files, logs, presence, …)
    location ^~ /api/v2/ {
        proxy_pass http://next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/health {
        proxy_pass http://next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Auth UI + password reset
    # Account: settings, bank-users, surveyors, staff, staff-permissions
    # Logs: activity viewer
    # Jobs: PI assign/fresh/schedule/pending/inspect/qc/complete/reports
    # Tools: PDF smoke UI
    location ~ ^/(login|logout|forgot-password|reset-password|dashboard|masters|account|logs|jobs|tools)(/|$) {
        proxy_pass http://next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: PI vehicle RC APIs on Next after Phase 4 parity verified
    # location ~ ^/api/(vehicle-rc|store-vahan-data|vehicle-info)$ {
    #     proxy_pass http://next_upstream;
    #     proxy_http_version 1.1;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # Next static / _next
    location ^~ /_next/ {
        proxy_pass http://next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # --- Legacy: Laravel (FI, Valuation, uncutover) ---
    # Catch-all keeps office/*, *valuation*, bank valuation portal, etc. on Laravel.
    location / {
        proxy_pass http://laravel_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
